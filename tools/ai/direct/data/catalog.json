            "ipc-dfm",
            "kicad-sch"
          ]
        },
        {
          "id": "REQUIREMENTS-02",
          "kind": "project-engineering-policy",
          "requirement": "分别选择性能等级、制造工艺能力和元器件环境等级；最高可靠性目标须落实到可验证需求",
          "verification": "查适用 IPC/产品标准、合同版本及供应商能力，不把工业级等同于 Class 3",
          "sourceIds": [
            "ipc-design",
            "ipc-dfm",
            "kicad-sch"
          ]
        },
        {
          "id": "REQUIREMENTS-03",
