          "verification": "审查电击、发热、火灾、反接、失控及单点失效的缓解和试验",
          "sourceIds": [
            "ipc-design",
            "ipc-dfm",
            "kicad-sch"
          ]
        },
        {
          "id": "REQUIREMENTS-04",
          "kind": "project-engineering-policy",
          "requirement": "记录电源、信号和机械接口预算及允许变化",
          "verification": "对需求边界、瞬态、容差、启动及异常工况做最坏情况分析",
          "sourceIds": [
            "ipc-design",
            "ipc-dfm",
            "kicad-sch"
          ]
        },
        {
          "id": "REQUIREMENTS-05",
          "kind": "project-engineering-policy",
