    {
      "id": "schematic",
      "title": "原理图拓扑与电气审查",
      "stage": "schematic",
      "aliases": [
        "原理图",
        "schematic",
        "电路",
        "层次",
        "总线"
      ],
      "requiredInputs": [
        "完整器件数据表/勘误",
        "功能框图与接口定义",
        "电源树/时序/电平"
      ],
      "rules": [
        {
          "id": "SCHEMATIC-01",
          "kind": "project-engineering-policy",
          "requirement": "依据实际功能和数据表设计电路，不依靠名称猜测引脚或参考值",
          "verification": "逐网络核对方向、电气类型、供电域、绝对最大值与工作范围",
          "sourceIds": [
            "kicad-sch",
            "phils-lab"
          ]
        },
        {
          "id": "SCHEMATIC-02",
          "kind": "project-engineering-policy",
          "requirement": "层次页、全局标签、总线成员和多单元器件必须完整一致",
          "verification": "检查所有子页、跨页网络、共用编号、隐藏电源引脚和未连接脚的意图",
          "sourceIds": [
            "kicad-sch",
            "phils-lab"
          ]
        },
        {
          "id": "SCHEMATIC-03",
          "kind": "project-engineering-policy",
          "requirement": "启动、复位、boot、调试和时钟应覆盖上电/掉电与异常状态",
          "verification": "审查上拉下拉、strap 采样、时序、调试连接及恢复通道",
          "sourceIds": [
            "kicad-sch",
            "phils-lab"
          ]
        },
        {
          "id": "SCHEMATIC-04",
          "kind": "project-engineering-policy",
          "requirement": "ERC 运行全部级别并复核例外；禁止靠改引脚类型、PWR_FLAG 或屏蔽错误伪造通过",
          "verification": "每个 no-connect、PWR_FLAG 和例外有电路依据和审查证据",
          "sourceIds": [
            "kicad-sch",
            "phils-lab"
          ]
        },
        {
          "id": "SCHEMATIC-05",
          "kind": "project-engineering-policy",
          "requirement": "仿真按模型适用范围和边界条件执行，仿真与实物分别验收",
          "verification": "保留模型来源/版本、测试平台、角落条件及实测差异",
          "sourceIds": [
            "kicad-sch",
            "phils-lab"
          ]
        }
      ],
      "sourceIds": [
        "kicad-sch",
        "phils-lab"
      ],
