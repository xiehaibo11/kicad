{
  // Editor and type-check project for the overlay sources. Each file sits at the path it takes in the
  // pinned OpenCode tui package, so imports resolve against cache/Kicad (run link-overlay.sh once).
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../cache/Kicad/packages/tui/tsconfig.json",
  "compilerOptions": {
    "rootDirs": [".", "../../../cache/Kicad/packages/tui"],
    "types": ["bun"],
    "noEmit": true
  },
  // The package's own ambient declarations (assets, generated SST types) come along unchanged.
  "include": ["src/**/*", "test/**/*", "../../../cache/Kicad/packages/tui/*.d.ts", "../../../cache/Kicad/packages/tui/src/*.d.ts"]
}
