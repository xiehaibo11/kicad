{
  // session-runtime.ts is bundled on its own by build-session-runtime.sh; it imports the shared
  // JavaScript runtime and the plugin helper from the pinned checkout (run link-overlay.sh once).
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "files": ["session-runtime.ts"]
}
